{
  "name": "cours-iut-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:init": "bun src/scripts/init-db.ts",
    "dev": "bunx next dev",
    "build": "bunx next build",
    "postbuild": "node scripts/postbuild.js",
    "postbuild_linux": "cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "postbuild_win": "xcopy .next\\static .next\\standalone\\.next\\ /Y /E && xcopy public .next\\standalone\\ /Y /E",
    "start": "node .next/standalone/server.js",
    "start:legacy": "bunx next start",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "extract-cours": "bun script/extractCours.js",
    "extract-coursmd": "bun script/extractToMarkdown.js",
    "generate-imports": "bun script/generateContentImports.js",
    "migrate-contents-refs": "bunx dotenv-cli -e .env -e .env.local -- bun src/scripts/migrate-contents-refs.ts",
    "migrate:db": "bunx dotenv-cli -e .env -e .env.local -- bun src/scripts/migrate-to-db.ts",
    "mcp:local": "bunx dotenv-cli -e .env -e .env.local -- bun src/scripts/mcp-local.ts",
    "create-content-index": "bunx dotenv-cli -e .env -e .env.local -- bun src/scripts/create-content-index.ts",
    "create-indexes": "bunx dotenv-cli -e .env -e .env.local -- bun src/scripts/create-indexes.ts",
    "migrate:project-spec": "bunx dotenv-cli -e .env -e .env.local -- bun src/scripts/migrate-project-spec.ts",
    "generate-skill": "bun scripts/generate-skill.ts",
    "seed-oauth-client": "bunx dotenv-cli -e .env -e .env.local -- bun scripts/seed-oauth-client.ts",
    "audit": "bun audit",
    "update": "bunx npm-check-updates -u && bun install",
    "test": "bun test",
    "prepare": "husky"
  },
